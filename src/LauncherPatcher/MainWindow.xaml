<Window x:Class="LauncherPatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LauncherPatcher.Localization"
        Title="LauncherPatcher"
        Width="640"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        FontFamily="{StaticResource FontMain}"
        FontSize="13"
        Foreground="{StaticResource Brush1}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <DataTemplate x:Key="PatchRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="22" Height="22" Margin="0,0,12,0" CornerRadius="11"
                        VerticalAlignment="Center" BorderThickness="1.5" BorderBrush="{Binding Accent}">
                    <Path Width="16" Height="16" Stretch="None" Data="{Binding Icon}"
                          Stroke="{Binding Accent}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                               Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{Binding Accent}" Text="{Binding StateText}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer margin leaves room for the window shadow. -->
    <Border Margin="12" CornerRadius="6" Background="{StaticResource BrushBackground}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="#1B3A66" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================== Title bar ======================== -->
            <Border x:Name="PanTitle" Background="{StaticResource BrushTitleBar}" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="PanTitle_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="28" Height="28" Source="Assets/Logo.png"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="LauncherPatcher" FontSize="19"
                                   FontWeight="Bold" Foreground="{StaticResource BrushWhite}" />
                        <Border Margin="12,1,0,0" Padding="7,1" VerticalAlignment="Center" CornerRadius="3"
                                Background="{StaticResource BrushHalfWhite}">
                            <TextBlock Text="{loc:Text App.Tag}" FontSize="12" Foreground="{StaticResource BrushWhite}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLanguage" Margin="0,0,8,0" Style="{StaticResource PclTitleBarTextButton}"
                                Content="{loc:Text App.LanguageButton}" ToolTip="{loc:Text App.LanguageTooltip}"
                                Click="BtnLanguage_Click" />
                        <Button x:Name="BtnMinimize" Style="{StaticResource PclTitleBarButton}" ToolTip="{loc:Text App.Minimize}"
                                Click="BtnMinimize_Click">
                            <Path Data="M0,0 L10,0" Stroke="{StaticResource BrushWhite}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="BtnClose" Margin="4,0,0,0" Style="{StaticResource PclTitleBarButton}"
                                ToolTip="{loc:Text App.Close}" Click="BtnClose_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource BrushWhite}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Both pages share one cell; the inactive one is Hidden, so the window keeps a stable height. -->
            <Grid Grid.Row="1">

            <!-- ======================== Main page ======================== -->
            <StackPanel x:Name="PanMain" Margin="22,20,22,18">

                <HeaderedContentControl Header="{loc:Text Main.Launcher}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LabFileName" FontSize="14" Text="{loc:Text Main.NoLauncher}" />
                                    <Border x:Name="PanVersion" Margin="8,0,0,0" Padding="6,0" CornerRadius="3"
                                            VerticalAlignment="Center" Background="{StaticResource Brush7}"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="LabVersion" FontSize="12" Foreground="{StaticResource Brush3}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="LabFilePath" Margin="0,3,0,0" FontSize="12"
                                           Foreground="{StaticResource BrushGray4}" TextTrimming="CharacterEllipsis"
                                           Text="{loc:Text Main.PickHint}" />
                            </StackPanel>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Margin="16,0,0,0" Content="{loc:Text Main.Browse}"
                                    Style="{StaticResource PclButton}" Click="BtnBrowse_Click" />
                        </Grid>

                        <ContentControl x:Name="HintStatus" Margin="0,14,0,0" Style="{StaticResource PclHint}">
                            <TextBlock x:Name="LabStatus" TextWrapping="Wrap" Text="{loc:Text Status.Searching}" />
                        </ContentControl>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button x:Name="BtnOpenFolder" Content="{loc:Text Main.OpenFolder}" Style="{StaticResource PclTextButton}"
                                    IsEnabled="False" Click="BtnOpenFolder_Click" />
                            <Button x:Name="BtnLaunch" Margin="16,0,0,0" Content="{loc:Text Main.LaunchPcl}"
                                    Style="{StaticResource PclTextButton}" Visibility="Collapsed"
                                    Click="BtnLaunch_Click" />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl x:Name="PanDownload" Margin="0,15,0,0" Header="{loc:Text Main.Download}"
                                        Style="{StaticResource PclCard}" Visibility="Collapsed">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Text Main.DownloadHmcl}" />
                            <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                                       Text="{loc:Text Main.DownloadHmclHint}" />
                        </StackPanel>
                        <Button x:Name="BtnDownloadHmcl" Grid.Column="1" Margin="12,0,0,0" MinWidth="72"
                                Content="{loc:Text Main.DownloadButton}" Style="{StaticResource PclButton}"
                                Click="BtnDownloadHmcl_Click" />
                        <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Text Main.DownloadPcl}" />
                            <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                                       Text="{loc:Text Main.DownloadPclHint}" />
                        </StackPanel>
                        <Button x:Name="BtnDownloadPcl" Grid.Column="3" Margin="12,0,0,0" MinWidth="72"
                                Content="{loc:Text Main.DownloadButton}" Style="{StaticResource PclButton}"
                                Click="BtnDownloadPcl_Click" />
                    </Grid>
                    <Grid x:Name="PanDownloadProgress" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BarDownload" VerticalAlignment="Center"
                                     Style="{StaticResource PclProgress}" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="LabDownloadPercent" Grid.Column="1" Margin="10,0,0,0" MinWidth="36"
                                   FontSize="12" Foreground="{StaticResource BrushGray4}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Main.Patches}" Style="{StaticResource PclCard}">
                    <ItemsControl x:Name="ListPatches" Focusable="False"
                                  ItemTemplate="{StaticResource PatchRowTemplate}" />
                </HeaderedContentControl>

                <Grid Margin="0,18,0,0">
                    <Button x:Name="BtnAbout" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Style="{StaticResource PclTextButton}" Foreground="{StaticResource BrushGray4}"
                            ToolTip="{loc:Text Main.AboutTooltip}" Click="BtnAbout_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="15" Height="15" CornerRadius="7.5" BorderThickness="1.3"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path Data="M0,0 L0,0.2 M0,2 L0,5.5" Stretch="None" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Border>
                            <TextBlock Margin="6,0,0,0" Text="{loc:Text Main.About}" />
                        </StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="BtnRestore" Content="{loc:Text Main.Restore}" Style="{StaticResource PclButton}"
                                IsEnabled="False" ToolTip="{loc:Text Main.RestoreTooltip}" Click="BtnRestore_Click" />
                        <Button x:Name="BtnFix" Margin="12,0,0,0" MinWidth="140" Content="{loc:Text Main.Fix}" FontWeight="Bold"
                                Style="{StaticResource PclButtonHighlight}" IsEnabled="False" Click="BtnFix_Click" />
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- ======================== About page ======================== -->
            <StackPanel x:Name="PanAbout" Margin="22,20,22,18" Visibility="Hidden">

                <HeaderedContentControl Header="{loc:Text About.Header}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="6" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LauncherPatcher" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Brush3}" />
                                    <Border Margin="10,2,0,0" Padding="6,0" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{StaticResource Brush7}">
                                        <TextBlock x:Name="LabAboutVersion" FontSize="12"
                                                   Foreground="{StaticResource Brush3}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                           Text="{loc:Text About.Summary}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="36" Height="36" Stroke="{StaticResource Brush6}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="Assets/Avatar.jpg" Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Xocio" />
                                <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                                           Text="{loc:Text About.AuthorRole}" />
                            </StackPanel>
                            <Button Grid.Column="2" MinWidth="88" Height="30" Content="{loc:Text About.Homepage}"
                                    Style="{StaticResource PclButton}" Tag="https://github.com/Xocio"
                                    Click="LinkButton_Click" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36">
                                <Ellipse Stroke="{StaticResource Brush6}" StrokeThickness="1"
                                         Fill="{StaticResource Brush6}" />
                                <TextBlock Text="S" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Skyearth1" />
                                <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                                           Text="{loc:Text About.Author2Role}" />
                            </StackPanel>
                            <Button Grid.Column="2" MinWidth="88" Height="30" Content="{loc:Text About.Homepage}"
                                    Style="{StaticResource PclButton}" Tag="https://github.com/PTlongling"
                                    Click="LinkButton_Click" />
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text About.Notes}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                   Text="{loc:Text About.Note1}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                   Text="{loc:Text About.Note2}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                   Text="{loc:Text About.Note3}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                   Text="{loc:Text About.Note4}" />
                    </StackPanel>
                </HeaderedContentControl>

                <Grid Margin="0,18,0,0">
                    <Button HorizontalAlignment="Right" Content="{loc:Text About.Back}" Style="{StaticResource PclButton}"
                            Click="BtnBack_Click" />
                </Grid>

            </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>
